APP_NAME=KeyFlow
APP_DESCRIPTION=Provider-scoped API key scheduling service.
APP_VERSION=0.1.0
PORT=8000
API_PREFIX=/api
INTERNAL_API_KEY=dev-internal-key
MODEL_ALIAS_CONFIG_PATH=config/model_aliases.yaml

# Runtime mode:
# - dev: PostgreSQL + Redis
# - local: single-container SQLite WAL, no PostgreSQL/Redis
KEYFLOW_RUNTIME_MODE=dev
LOCAL_SQLITE_PATH=/data/keyflow.db

# PostgreSQL / Redis：本地联调时由仓库内 Compose 启动（见 README「Docker 本地联调」）。
# 服务/容器名为 keyflow-postgres、keyflow-redis，与 `docker/postgresql`、`docker/redis` 中定义一致。
# 若使用外部实例，请改为可达的主机与端口。
DATABASE_URL_READ=postgresql+asyncpg://keyflow:keyflow@keyflow-postgres:5432/keyflow
DATABASE_URL_WRITE=postgresql+asyncpg://keyflow:keyflow@keyflow-postgres:5432/keyflow
REDIS_URL=redis://keyflow-redis:6379/0
LOG_LEVEL=INFO
# v1：API 与 worker 共用同一镜像；HTTP 进程默认单 worker，避免同一容器内重复起多份 API 进程。
UVICORN_WORKERS=1
BACKGROUND_TASK_INTERVAL_SECONDS=60

# Provider plugin outbound HTTP
GLOBAL_HTTP_PROXY=
HTTP_CONNECT_TIMEOUT=3
HTTP_READ_TIMEOUT=8
HTTP_TOTAL_TIMEOUT=12

# 分配参数
ALLOCATE_IDLE_CAP_SECONDS=300
ALLOCATE_ERROR_CAP=10
ALLOCATE_JITTER=0.01
ALLOCATE_LEASE_SECONDS=2

# 评分权重
WEIGHT_QUOTA=0.4
WEIGHT_IDLE=0.25
WEIGHT_SUCCESS=0.2
WEIGHT_ERROR=0.1
WEIGHT_RATE_LIMIT=0.03
WEIGHT_COOLDOWN=0.02
