APP_NAME=KeyFlow
API_PREFIX=/api
INTERNAL_API_KEY=dev-internal-key

# PostgreSQL 读写分离（从 .env 读取）
# 本地开发用 localhost，Docker 部署用 postgres 作为 host
DATABASE_URL_READ=postgresql+asyncpg://keyflow:keyflow@localhost:5432/keyflow
DATABASE_URL_WRITE=postgresql+asyncpg://keyflow:keyflow@localhost:5432/keyflow

# Redis（从 .env 读取）
# 本地开发用 localhost，Docker 部署用 redis 作为 host
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
ALLOCATE_IDLE_CAP_SECONDS=300
ALLOCATE_ERROR_CAP=10
ALLOCATE_JITTER=0.01
WEIGHT_QUOTA=0.4
WEIGHT_IDLE=0.25
WEIGHT_SUCCESS=0.2
WEIGHT_ERROR=0.1
WEIGHT_RATE_LIMIT=0.03
WEIGHT_COOLDOWN=0.02
